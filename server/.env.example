# Where your locally running Altinn apps are served.
ALTINN_APP_HOST=http://local.altinn.cloud:8000

# The Altinn Studio LocalTest project, which mints test user tokens
# (GET {ALTINN_LOCALTEST_URL}/Home/GetTestUserToken/{userId}).
ALTINN_LOCALTEST_URL=http://localhost:5101

# Optional overrides
PORT=4000
WEB_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_MS=30000

# What the api binds to. Loopback by default, since it holds live test tokens and will post with
# them for anyone who can reach it. Set 0.0.0.0 only on a network you trust.
# HOST=127.0.0.1

# Example data that lives on disk: the subforms, the forms the testmotor below has no data for,
# and the attachment dummies. Defaults to the examples/ directory in this repo. It expects
# forms/{dataType}/*.xml, subforms/{dataType}/*.xml and attachments/* underneath.
# ALTINN_EXAMPLE_DATA_DIR=/path/to/exampleData

# The FtPB testmotor, which serves the main form examples. They come from here rather than from
# this repo because it re-stamps their date fields on every request, so an example whose rules
# insist on a date within the next fortnight is in that window whenever it is asked for. It is
# hosted and carries no token. Empty it to switch the feature off, which leaves only the examples
# on disk.
# TESTMOTOR_URL=https://app-ftpb-testmotor.azurewebsites.net

# The DIBK validation service, which answers what a submission actually requires. Hosted, and
# carries no token. Empty it to switch the feature off.
# VALIDATION_URL=https://validering.ft-test.dibk.no/api/validationReport
